# --------------------------------------------------
# GEMINI CONFIGURATION
# --------------------------------------------------

GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Current Gemini model
GEMINI_MODEL=gemini-3.8-flash


# --------------------------------------------------
# LOCAL EXPLANATION MODEL
# --------------------------------------------------

LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M

# true  = use local LaMini model first
# false = use Gemini for explanation
USE_LOCAL_EXPLAINER=false

LOCAL_MAX_NEW_TOKENS=180


# --------------------------------------------------
# APPLICATION
# --------------------------------------------------

MAX_INPUT_CHARS=12000

HOST=127.0.0.1

PORT=8000

APP_NAME=EduGenie - AI Learning Assistant

APP_VERSION=1.0.0